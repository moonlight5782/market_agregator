{
  "name": "moldova-commerce",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:replit": "DEMO_MODE=true next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-locations.ts",
    "data:crawl": "python -m services.scraper.run",
    "data:import": "tsx scripts/import-raw.ts",
    "data:sync": "tsx scripts/sync-store.ts",
    "data:sync:verified": "node scripts/sync-verified-stores.mjs",
    "data:status": "tsx scripts/store-health.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "prisma": "^6.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "prisma": {"seed": "tsx prisma/seed.ts && tsx prisma/seed-locations.ts"}
}
