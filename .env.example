DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moldova_commerce
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
MARKETPLACE_CHECKOUT=false
OFFER_MAX_AGE_HOURS=48
SEED_SAMPLE_PRODUCTS=false

# OAuth / user accounts (Auth.js)
AUTH_SECRET=replace-with-a-long-random-production-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Recommended separate key for loyalty-card AES-256-GCM encryption.
# If omitted the app falls back to AUTH_SECRET.
LOYALTY_CARD_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
