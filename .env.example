DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moldova_commerce
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
MARKETPLACE_CHECKOUT=false
OFFER_MAX_AGE_HOURS=48
SEED_SAMPLE_PRODUCTS=false

# OAuth / user accounts (Auth.js)
AUTH_SECRET=replace-with-a-long-random-production-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Loyalty-card AES-256-GCM encryption.
# Production requires a dedicated key; AUTH_SECRET fallback is development-only.
# New payloads use v2.<key-id>... so keys can be rotated while old versions remain decryptable.
LOYALTY_CARD_KEY_ID=v1
LOYALTY_CARD_ENCRYPTION_KEY_V1=replace-with-a-separate-long-random-secret
# Legacy compatibility for payloads encrypted before key IDs were introduced.
LOYALTY_CARD_ENCRYPTION_KEY=replace-with-the-same-v1-secret-during-migration
