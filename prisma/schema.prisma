generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  API
  FEED
  JSON
  XML
  CSV
  YML
  SITEMAP
  HTML
  BROWSER
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
  UNKNOWN
}

enum CheckoutType {
  EXTERNAL
  PLATFORM
}

enum MatchMethod {
  EAN
  MPN
  SKU
  BRAND_MODEL
  NORMALIZED_TITLE
  FUZZY
  MANUAL
}

enum ScraperRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum LoyaltyBarcodeFormat {
  QR_CODE
  AZTEC
  DATA_MATRIX
  PDF_417
  CODE_128
  CODE_39
  EAN_13
  EAN_8
  UPC_A
  UPC_E
  CODABAR
  ITF
}

enum LoyaltyCardStatus {
  ACTIVE
  ARCHIVED
  EXPIRED
}

enum LoyaltyEventType {
  EARN
  REDEEM
  ADJUSTMENT
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  loyaltyCards  LoyaltyCard[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Store {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  domain          String           @unique
  description     String?
  logoUrl         String?
  active          Boolean          @default(true)
  verified        Boolean          @default(false)
  sources         StoreSource[]
  locations       StoreLocation[]
  offers          Offer[]
  scraperRuns     ScraperRun[]
  loyaltyPrograms LoyaltyProgram[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model LoyaltyProgram {
  id                String        @id @default(cuid())
  storeId           String?
  name              String
  issuer            String?
  externalProgramId String?
  logoUrl           String?
  websiteUrl        String?
  supportsEarn      Boolean       @default(false)
  supportsRedeem    Boolean       @default(false)
  active            Boolean       @default(true)
  store             Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  cards             LoyaltyCard[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([storeId, externalProgramId])
  @@index([name])
}

model LoyaltyCard {
  id                   String               @id @default(cuid())
  userId               String
  programId            String?
  label                String
  cardholderName       String?
  barcodeFormat        LoyaltyBarcodeFormat
  encryptedPayload     String
  payloadLast4         String?
  color                 String?
  notes                 String?
  expiresAt             DateTime?
  favorite              Boolean              @default(false)
  status                LoyaltyCardStatus     @default(ACTIVE)
  externalCardId        String?
  pointsBalanceSnapshot Decimal?              @db.Decimal(14,2)
  pointsUnit            String?
  balanceUpdatedAt      DateTime?
  integrationMetadata   Json?
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  program               LoyaltyProgram?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  events                LoyaltyEvent[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([userId, status])
  @@index([programId])
}

model LoyaltyEvent {
  id          String           @id @default(cuid())
  cardId      String
  type        LoyaltyEventType
  amount      Decimal          @db.Decimal(14,2)
  externalRef String?
  description String?
  occurredAt  DateTime         @default(now())
  metadata    Json?
  card        LoyaltyCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, occurredAt])
}

model StoreLocation {
  id              String              @id @default(cuid())
  storeId         String
  externalId      String?
  name            String
  address         String?
  city            String
  latitude        Float?
  longitude       Float?
  phone           String?
  openingHours    Json?
  active          Boolean             @default(true)
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  offers          Offer[]
  availabilities  OfferAvailability[]
  @@unique([storeId, externalId])
  @@index([storeId, city])
  @@index([city, active])
}

model StoreSource {
  id             String     @id @default(cuid())
  storeId        String
  type           SourceType
  url            String
  enabled        Boolean    @default(true)
  crawlFrequency Int        @default(360)
  lastCrawl      DateTime?
  lastSuccess    DateTime?
  lastError      String?
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@index([storeId, enabled])
}

model ScraperRun {
  id               String           @id @default(cuid())
  storeId          String
  status           ScraperRunStatus @default(RUNNING)
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?
  productsFound    Int              @default(0)
  productsImported Int              @default(0)
  errors           Int              @default(0)
  reportPath       String?
  errorMessage     String?
  metrics          Json?
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@index([storeId, startedAt])
  @@index([status, startedAt])
}

model Category {
  id       String     @id @default(cuid())
  nameRo   String
  nameRu   String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  normalizedTitle String
  description     String?
  brandId         String?
  categoryId      String?
  ean             String?
  mpn             String?
  sku             String?
  imageUrl        String?
  attributes      Json?
  dataQuality     Float     @default(0)
  brand           Brand?    @relation(fields: [brandId], references: [id])
  category        Category? @relation(fields: [categoryId], references: [id])
  offers          Offer[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([normalizedTitle])
  @@index([ean])
  @@index([mpn])
}

model Offer {
  id              String       @id @default(cuid())
  productId       String
  storeId         String
  locationId      String?
  externalId      String?
  title           String
  price           Decimal      @db.Decimal(14,2)
  oldPrice        Decimal?     @db.Decimal(14,2)
  currency        String       @default("MDL")
  stockStatus     StockStatus  @default(UNKNOWN)
  quantity        Int?
  externalUrl     String
  checkoutType    CheckoutType @default(EXTERNAL)
  imageUrl        String?
  lastSeenAt      DateTime     @default(now())
  lastPriceUpdate DateTime     @default(now())
  lastStockUpdate DateTime     @default(now())
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  location        StoreLocation? @relation(fields: [locationId], references: [id])
  availabilities  OfferAvailability[]
  priceHistory    PriceHistory[]
  @@unique([storeId, externalId])
  @@index([productId, price])
  @@index([storeId, stockStatus])
}

model OfferAvailability {
  id              String        @id @default(cuid())
  offerId         String
  locationId      String
  stockStatus     StockStatus   @default(UNKNOWN)
  quantity        Int?
  lastSeenAt      DateTime      @default(now())
  lastStockUpdate DateTime      @default(now())
  offer           Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  location        StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  @@unique([offerId, locationId])
  @@index([locationId, stockStatus])
  @@index([offerId, lastSeenAt])
}

model PriceHistory {
  id         String   @id @default(cuid())
  offerId    String
  price      Decimal  @db.Decimal(14,2)
  recordedAt DateTime @default(now())
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  @@index([offerId, recordedAt])
}

model ProductMatch {
  id              String      @id @default(cuid())
  sourceKey       String
  targetProductId String
  confidence      Float
  method          MatchMethod
  status          String      @default("PENDING")
  reviewedAt      DateTime?
  @@index([status, confidence])
}
